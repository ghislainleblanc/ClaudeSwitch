    "setup.explanation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Switch saves the current session under the profile you pick, then lets you flip between your personal and work accounts in one click."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Switch enregistre la session actuelle sous le profil choisi, puis vous permet de basculer entre vos comptes personnel et professionnel en un clic."
          }
        }
      }
    },
    "setup.question" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which account is Claude Desktop signed in to right now?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quel compte Claude Desktop est-il connecté en ce moment ?"
          }
        }
      }
    },
    "status.failureFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
