{
  "sourceLanguage" : "en",
  "strings" : {
    "app.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Switch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Switch"
          }
        }
      }
    },
    "error.claudeNotInstalled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop is not installed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop n’est pas installé."
          }
        }
      }
    },
    "error.noSnapshotFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saved session for the %@ profile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune session enregistrée pour le profil %@."
          }
        }
      }
    },
    "error.recoveryFailed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t repair an interrupted switch. Check ~/Library/Application Support/Claude Switch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de réparer un changement interrompu. Vérifiez ~/Library/Application Support/Claude Switch."
          }
        }
      }
    },
    "error.quitTimedOut" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop did not quit in time. Quit it manually, then try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop ne s’est pas fermé à temps. Fermez-le manuellement, puis réessayez."
          }
        }
      }
    },
    "menu.quit" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit Claude Switch"
          }
